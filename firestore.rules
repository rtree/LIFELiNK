rules_version = '2';

// LIFELiNK Firestore security rules skeleton.
// Design source: doc/plan.md sections 6, 6a, 9.
//
// All writes to app data currently happen through the Cloud Run backend using
// the Firebase Admin SDK, which bypasses these rules entirely. Client apps
// (Android owner + linked friends) only ever read directly from Firestore for
// the real-time Discord-style feed; every write goes through a `POST /v1/...`
// API endpoint so backend can validate ownership, idempotency, and injection
// into the live call before persisting. Until that decision changes, keep all
// client-side writes denied by default.
//
// TODO(P1): if a future perf/latency need requires direct client writes for
// `friend_comment`, replace the relevant `allow write: if false;` with a rule
// that checks `request.auth.uid in get(.../emergency_events/$(eventId)).data.participant_uids`
// and `request.resource.data.author_uid == request.auth.uid`, matching 6a.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // users/{uid}
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      // users/{uid}/contacts/{contact_id}
      match /contacts/{contactId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // users/{uid}/locations/{location_id}
      match /locations/{locationId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // friend_links/{link_id}, doc id = min(uidA, uidB) + "_" + max(uidA, uidB)
    match /friend_links/{linkId} {
      allow read: if isSignedIn() &&
        request.auth.uid in [resource.data.uid_a, resource.data.uid_b];
      allow write: if false;
    }

    // emergency_events/{emergency_event_id}
    match /emergency_events/{eventId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.uid ||
         request.auth.uid in resource.data.participant_uids);
      allow write: if false;

      // emergency_events/{emergency_event_id}/updates/{update_id}
      match /updates/{updateId} {
        allow read: if isSignedIn() &&
          (request.auth.uid == get(/databases/$(database)/documents/emergency_events/$(eventId)).data.uid ||
           request.auth.uid in get(/databases/$(database)/documents/emergency_events/$(eventId)).data.participant_uids);
        allow write: if false;
      }
    }

    // users/{uid}/emergencySessions/{session_id} — P2 target schema, doc/plan.md 8a.
    // Nested under the owner (2026-09-26 decision) so owner checks use the path
    // segment directly instead of a stored field. Not yet written by backend;
    // rules added ahead of implementation so the collection is never
    // accidentally left on open/default rules.
    match /users/{ownerUid}/emergencySessions/{sessionId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == ownerUid ||
         request.auth.uid in resource.data.participant_uids);
      allow write: if false;

      function canReadSession() {
        return isSignedIn() &&
          (request.auth.uid == ownerUid ||
           request.auth.uid in get(/databases/$(database)/documents/users/$(ownerUid)/emergencySessions/$(sessionId)).data.participant_uids);
      }

      // users/{uid}/emergencySessions/{session_id}/state/current
      match /state/{stateId} {
        allow read: if canReadSession();
        allow write: if false;
      }

      // users/{uid}/emergencySessions/{session_id}/facts/{fact_id}
      match /facts/{factId} {
        allow read: if canReadSession();
        allow write: if false;
      }

      // users/{uid}/emergencySessions/{session_id}/timeline/{event_id}
      match /timeline/{eventId} {
        allow read: if canReadSession();
        allow write: if false;
      }

      // users/{uid}/emergencySessions/{session_id}/delegations/{delegation_id}
      match /delegations/{delegationId} {
        allow read: if canReadSession();
        allow write: if false;
      }
    }

    // world_id_nullifiers/{action}_{nullifier} — replay-protection ledger.
    // Written only by backend (Admin SDK via `.create()`); never client-readable.
    match /world_id_nullifiers/{nullifierId} {
      allow read, write: if false;
    }

    match /world_id_reverifications/{verificationId} {
      allow read, write: if false;
    }

  }
}
